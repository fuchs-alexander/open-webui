# Keep the deployed v0.12.4 runtime and frontend; replace only the identity module.
# This base digest matches the official image running before the branding change.
FROM ghcr.io/open-webui/open-webui:v0.12.4@sha256:a5b9e403d19154796850679c8c5d1295301cee954be8b84ddd62af92426558f7

COPY backend/open_webui/env.py /app/backend/open_webui/env.py
ENV WEBUI_NAME=PosylkaAI
